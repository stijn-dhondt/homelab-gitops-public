# Copy to ".env" in the same folder, OR paste these as "Environment variables"
# in the Portainer stack editor (Stacks -> Add/Edit stack -> Environment variables).

# Latest Omni release tag, e.g. v0.55.0
# Find it at: https://github.com/siderolabs/omni/releases/latest
OMNI_VERSION=

# Internal hostnames you mapped in /etc/hosts on the Docker host (and on any
# machine you'll access the Omni UI from). These do NOT need to be real
# public DNS names for a home-cluster / LAN-only setup.
OMNI_ENDPOINT=omni.internal
AUTH_ENDPOINT=auth.internal

# The IP the Omni host is reachable on from your home cluster nodes (and,
# if you want remote access, its public IP). For a pure LAN setup this can
# be the host's LAN IP.
HOST_PUBLIC_IP=

# Login email for the first Omni admin user (must match the email used when
# generating the Dex password hash in setup-host-prereqs.sh)
OMNI_USER_EMAIL=admin@omni.internal

# EULA acceptance (required for self-hosted, non-production use)
EULA_NAME=Your Name
EULA_EMAIL=your@email.com
