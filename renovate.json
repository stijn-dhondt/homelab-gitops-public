{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "flux": {
    "managerFilePatterns": [
      "/(?:^|/)gotk-components\\.ya?ml$/",
      "/(?:^|/)helmrelease\\.ya?ml$/",
      "/(?:^|/)helmrepository\\.ya?ml$/"
    ]
  },
  "customManagers": [
    {
      "customType": "regex",
      "fileMatch": ["^clusters/talos-dev/talos-version\\.yaml$"],
      "matchStrings": [
        "datasource=(?<datasource>.*?) depName=(?<depName>.*?)\\s+talosVersion:\\s*(?<currentValue>v?\\d+\\.\\d+\\.\\d+)"
      ]
    },
    {
      "customType": "regex",
      "fileMatch": ["^clusters/talos-dev/apps/n8n/helmrelease\\.ya?ml$"],
      "matchStrings": [
        "datasource=(?<datasource>.*?) depName=(?<depName>.*?) versioning=(?<versioning>.*?)\\s+tag:\\s*[\"'](?<currentValue>\\d+\\.\\d+\\.\\d+)[\"']"
      ]
    }
  ]
}
